# Line endings pinned to LF. Adapters are copied verbatim into other projects and
# emitted into agent config files; a CRLF checkout on Windows produces hook scripts
# that fail on Linux with `bad interpreter: ...^M` — on the adopter's machine, not
# ours. The attribute governs checkout; the writers emit LF regardless of platform.

*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.toml text eol=lf

# The vendor example pages are produced by examples/generate.py, never edited by hand.
# Marking them collapses them in GitHub diffs, so a review shows the behaviour change
# rather than the eleven pages that followed from it -- and they stay reviewable by
# expanding, which is the right default for output you are meant to check but not read
# line by line.
examples/generated/*.md linguist-generated=true

# The hook has no extension, so the *.sh rule above misses it. A CRLF checkout would
# make it fail with `bad interpreter` on the machine that enabled it.
.githooks/* text eol=lf
