{
  "agent": "junie",
  "claims": {
    "accept_markers": [
      "project_path"
    ],
    "event_key": [
      "hook_event_name"
    ],
    "mode": "marker"
  },
  "config_format": "json",
  "config_path": "~/.junie/config.json",
  "display": "Junie CLI",
  "events": {
    "PermissionRequest": "pre_tool",
    "PreToolUse": "pre_tool",
    "SessionEnd": "session_end",
    "SessionStart": "session_start",
    "Stop": "stop",
    "UserPromptSubmit": "prompt_submit"
  },
  "evidence": {
    "claims": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_examples.py::test_each_payload_is_claimed_by_its_own_adapter"
    },
    "config_path": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_vendor_config.py::test_config_path_agrees_with_matrix"
    },
    "events": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_examples.py::test_each_payload_parses_to_the_event_it_is_filed_under"
    },
    "family": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_golden_fixtures.py::test_wire_output_matches_the_frozen_fixture"
    },
    "fields": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_vendor_config.py::test_entries_match_recount"
    },
    "hook_entry": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_golden_fixtures.py::test_hook_config_matches_the_frozen_fixture_on_both_matcher_paths"
    },
    "loads_claude_plugins": {
      "basis": "vendor-docs",
      "date": "2026-10-17",
      "test": "tests/test_claude_plugins.py::test_each_entry_records_the_discovery_row"
    },
    "tools": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_vendor_config.py::test_entries_match_recount"
    },
    "verdicts": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_golden_fixtures.py::test_wire_output_matches_the_frozen_fixture"
    }
  },
  "family": "flat_decision",
  "fields": {
    "command": [
      "tool_input.command"
    ],
    "content": [
      "tool_input.content",
      "tool_input.new_string",
      "tool_input.new_source",
      "tool_input.edits[].new_string"
    ],
    "cwd": [
      "cwd",
      "project_path"
    ],
    "output": [
      "last_assistant_message"
    ],
    "path": [
      "tool_input.file_path",
      "tool_input.path",
      "tool_input.notebook_path"
    ],
    "prompt": [
      "prompt"
    ],
    "session_id": [
      "session_id"
    ],
    "tool": [
      "tool_name"
    ]
  },
  "hook_entry": {
    "matcher": true,
    "wrapper": "hooks_map"
  },
  "loads_claude_plugins": {
    "deny_reply": "partial",
    "hooks": "yes",
    "how": "through a Claude-format marketplace: /extensions marketplace add with a .claude-plugin/marketplace.json index; interactive install; cached in ~/.junie/extensions/",
    "loads": "yes",
    "notes": "per-extension manifest undocumented; hooks are Early Access; exit 2 and a top-level decision block, HSO not documented as blocking",
    "payload": "Claude Code (hook_event_name, tool_name: \"Bash\")",
    "source": "https://junie.jetbrains.com/docs/junie-cli-extensions.html (org-plan discovery/2026-10-17-claude-plugin-compat.md)"
  },
  "needs_trust": false,
  "tools": {},
  "verdicts": {
    "allow_context_key": "additionalContext",
    "allow_silent_events": [
      "Stop"
    ],
    "answer_events": [
      "PermissionRequest",
      "PreToolUse",
      "Stop",
      "UserPromptSubmit"
    ],
    "bare_allow": "required",
    "context_source": "reason",
    "degrade_notes": {
      "transform_missing_input": "no replacement input was supplied"
    },
    "gate_reason_defaults": {
      "Stop": "not finished"
    },
    "gates": {
      "PermissionRequest": {
        "grammar": "G1",
        "honours_escalate": false,
        "honours_transform": false
      },
      "PreToolUse": {
        "grammar": "G1",
        "honours_escalate": true,
        "honours_transform": true
      },
      "Stop": {
        "grammar": "G1",
        "honours_escalate": false,
        "honours_transform": false
      },
      "UserPromptSubmit": {
        "grammar": "G1",
        "honours_escalate": true,
        "honours_transform": false
      }
    },
    "note_style": "suffix",
    "reason_defaults": {
      "escalate_gate": "confirmation required",
      "transform": "input requires modification"
    },
    "transform_grammar": "top_level_updated_input",
    "vocabulary": [
      "allow",
      "ask",
      "block"
    ],
    "vocabulary_basis": "verified",
    "words": {
      "allow": "allow",
      "block": "block",
      "escalate": "ask",
      "transform": "allow"
    }
  },
  "wire_events": {
    "pre_tool": "PreToolUse"
  }
}
