{
  "agent": "goose",
  "claims": {
    "event_key": [
      "event"
    ],
    "mode": "marker",
    "notes": "goose names the event under `event`, a key no other adapter's payload uses (every other marker family reads hook_event_name or hookEventName), so the event key alone separates it."
  },
  "config_format": "json",
  "config_path": ".agents/plugins/agentseam/hooks/hooks.json",
  "display": "goose",
  "events": {
    "AfterFileEdit": "file_changed",
    "AfterShellExecution": "unknown",
    "BeforeReadFile": "unknown",
    "BeforeShellExecution": "unknown",
    "PostToolUse": "post_tool",
    "PostToolUseFailure": "tool_failure",
    "PreToolUse": "pre_tool",
    "PreToolUseResult": "unknown",
    "SessionEnd": "session_end",
    "SessionStart": "session_start",
    "Stop": "stop",
    "UserPromptSubmit": "prompt_submit"
  },
  "evidence": {
    "claims": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_examples.py::test_each_payload_is_claimed_by_its_own_adapter"
    },
    "config_path": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_vendor_config.py::test_config_path_agrees_with_matrix"
    },
    "events": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_examples.py::test_each_payload_parses_to_the_event_it_is_filed_under"
    },
    "family": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_golden_fixtures.py::test_wire_output_matches_the_frozen_fixture"
    },
    "fields": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_vendor_config.py::test_entries_match_recount"
    },
    "hook_entry": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_golden_fixtures.py::test_hook_config_matches_the_frozen_fixture_on_both_matcher_paths"
    },
    "loads_claude_plugins": {
      "basis": "vendor-source",
      "date": "2026-10-17",
      "test": "tests/test_claude_plugins.py::test_each_entry_records_the_discovery_row"
    },
    "tools": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_vendor_config.py::test_entries_match_recount"
    },
    "verdicts": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_golden_fixtures.py::test_wire_output_matches_the_frozen_fixture"
    }
  },
  "family": "flat_decision",
  "fields": {
    "command": [
      "tool_input.command"
    ],
    "content": [
      "tool_input.content",
      "tool_input.after"
    ],
    "cwd": [
      "working_dir"
    ],
    "path": [
      "tool_input.path"
    ],
    "prompt": [
      "message"
    ],
    "session_id": [
      "session_id"
    ],
    "tool": [
      "tool_name"
    ],
    "tool_use_id": [
      "tool_call_id"
    ]
  },
  "hook_entry": {
    "entry_extra": {
      "on_failure": "block"
    },
    "matcher": true,
    "wrapper": "hooks_map"
  },
  "loads_claude_plugins": {
    "deny_reply": "partial",
    "hooks": "yes",
    "how": "place the folder in .agents/plugins/<name>/ or ~/.agents/plugins/<name>/ (loads by layout; .claude-plugin/plugin.json is not a goose manifest); no ~/.claude/plugins, no Claude marketplace",
    "loads": "partial",
    "notes": "hooks/hooks.json runs; exit 2 or {\"decision\":\"block\"} blocks; HSO is not parsed",
    "payload": "own: key event, not hook_event_name; goose tool names (developer__shell)",
    "source": "block/goose@bfcc6ee crates/goose/src/plugins/formats/open_plugins.rs, crates/goose/src/hooks/mod.rs (org-plan discovery/2026-10-17-claude-plugin-compat.md)"
  },
  "needs_trust": false,
  "tools": {
    "shell": [
      "shell"
    ],
    "write": [
      "write",
      "edit"
    ]
  },
  "verdicts": {
    "answer_events": [
      "PreToolUse",
      "Stop"
    ],
    "bare_allow": "silent",
    "degrade_notes": {
      "escalate": "goose cannot prompt for confirmation",
      "escalate_from_transform": "goose cannot modify a tool call",
      "transform": "goose cannot modify a tool call"
    },
    "gates": {
      "PreToolUse": {
        "grammar": "G1",
        "honours_escalate": false,
        "honours_transform": false
      },
      "Stop": {
        "grammar": "G1",
        "honours_escalate": false,
        "honours_transform": false
      }
    },
    "note_style": "because",
    "vocabulary": [
      "allow",
      "block"
    ],
    "vocabulary_basis": "verified",
    "words": {
      "block": "block"
    }
  }
}
