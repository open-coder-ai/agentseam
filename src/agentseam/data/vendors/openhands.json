{
  "agent": "openhands",
  "claims": {
    "event_key": [
      "event_type"
    ],
    "mode": "marker",
    "notes": "OpenHands names the event under `event_type`, a key no other adapter's payload uses, so the event key alone separates it (docs.openhands.dev hooks page, read 2026-10-11)."
  },
  "config_format": "json",
  "config_path": ".openhands/hooks.json",
  "display": "OpenHands",
  "events": {
    "PostToolUse": "post_tool",
    "PreToolUse": "pre_tool",
    "SessionEnd": "session_end",
    "SessionStart": "session_start",
    "Stop": "stop",
    "UserPromptSubmit": "prompt_submit"
  },
  "evidence": {
    "claims": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_examples.py::test_each_payload_is_claimed_by_its_own_adapter"
    },
    "config_path": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_vendor_config.py::test_config_path_agrees_with_matrix"
    },
    "events": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_examples.py::test_each_payload_parses_to_the_event_it_is_filed_under"
    },
    "family": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_golden_fixtures.py::test_wire_output_matches_the_frozen_fixture"
    },
    "fields": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_vendor_config.py::test_entries_match_recount"
    },
    "hook_entry": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_golden_fixtures.py::test_hook_config_matches_the_frozen_fixture_on_both_matcher_paths"
    },
    "tools": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_vendor_config.py::test_entries_match_recount"
    },
    "verdicts": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_golden_fixtures.py::test_wire_output_matches_the_frozen_fixture"
    }
  },
  "family": "flat_decision",
  "fields": {
    "command": [
      "tool_input.command"
    ],
    "content": [
      "tool_input.file_text",
      "tool_input.new_str"
    ],
    "cwd": [
      "working_dir"
    ],
    "output": [
      "tool_response"
    ],
    "path": [
      "tool_input.path"
    ],
    "prompt": [
      "message"
    ],
    "session_id": [
      "session_id"
    ],
    "tool": [
      "tool_name"
    ]
  },
  "hook_entry": {
    "matcher": true,
    "wrapper": "hooks_map"
  },
  "needs_trust": false,
  "tools": {
    "shell": [
      "terminal"
    ],
    "write": [
      "file_editor"
    ]
  },
  "verdicts": {
    "answer_events": [
      "PreToolUse",
      "Stop",
      "UserPromptSubmit"
    ],
    "bare_allow": "silent",
    "degrade_notes": {
      "escalate": "OpenHands cannot prompt for confirmation",
      "escalate_from_transform": "OpenHands cannot modify a tool call",
      "transform": "OpenHands cannot modify a tool call"
    },
    "gates": {
      "PreToolUse": {
        "grammar": "G1",
        "honours_escalate": false,
        "honours_transform": false
      },
      "Stop": {
        "grammar": "G1",
        "honours_escalate": false,
        "honours_transform": false
      },
      "UserPromptSubmit": {
        "grammar": "G1",
        "honours_escalate": false,
        "honours_transform": false
      }
    },
    "note_style": "because",
    "vocabulary": [
      "deny"
    ],
    "vocabulary_basis": "verified",
    "words": {
      "block": "deny"
    }
  }
}
