{
  "agent": "factory_droid",
  "claims": {
    "accept_values": {
      "permission_mode": [
        "off",
        "spec",
        "auto-low",
        "auto-medium",
        "auto-high"
      ]
    },
    "event_key": [
      "hook_event_name"
    ],
    "mode": "marker",
    "notes": "Droid's payload carries Claude Code's keys, so only a value separates it: every Droid event carries permission_mode, and Droid sends only off, spec, auto-low, auto-medium or auto-high there (docs.factory.com/harness/hooks, read 2026-10-11; droid 0.238.0's own hook-input builder maps every autonomy mode to one of those five, defaulting to off). claude_code rejects exactly those values (reject_values), so a payload is claimed by one of the two and never by both. A Droid build that sent a Claude Code permission_mode value would detect as claude_code again, whose deny Droid also reads."
  },
  "config_format": "json",
  "config_path": ".factory/hooks.json",
  "display": "Factory Droid",
  "events": {
    "PostToolUse": "post_tool",
    "PreCompact": "pre_compact",
    "PreToolUse": "pre_tool",
    "SessionEnd": "session_end",
    "SessionStart": "session_start",
    "Stop": "stop",
    "SubagentStop": "subagent_stop",
    "UserPromptSubmit": "prompt_submit"
  },
  "evidence": {
    "claims": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_examples.py::test_each_payload_is_claimed_by_its_own_adapter"
    },
    "config_path": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_vendor_config.py::test_config_path_agrees_with_matrix"
    },
    "events": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_examples.py::test_each_payload_parses_to_the_event_it_is_filed_under"
    },
    "family": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_golden_fixtures.py::test_wire_output_matches_the_frozen_fixture"
    },
    "fields": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_vendor_config.py::test_entries_match_recount"
    },
    "hook_entry": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_golden_fixtures.py::test_hook_config_matches_the_frozen_fixture_on_both_matcher_paths"
    },
    "tools": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_vendor_config.py::test_entries_match_recount"
    },
    "verdicts": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_golden_fixtures.py::test_wire_output_matches_the_frozen_fixture"
    }
  },
  "family": "hook_json",
  "fields": {
    "command": [
      "tool_input.command"
    ],
    "content": [
      "tool_input.content",
      "tool_input.new_str",
      "tool_input.changes[].new_str",
      "tool_input.input"
    ],
    "cwd": [
      "cwd"
    ],
    "output": [
      "tool_response"
    ],
    "path": [
      "tool_input.file_path"
    ],
    "prompt": [
      "prompt"
    ],
    "session_id": [
      "session_id"
    ],
    "tool": [
      "tool_name"
    ]
  },
  "hook_entry": {
    "bare": true,
    "matcher": true,
    "wrapper": "hooks_map"
  },
  "needs_trust": false,
  "tools": {
    "shell": [
      "Execute"
    ],
    "write": [
      "Create",
      "Edit",
      "MultiEdit",
      "ApplyPatch"
    ]
  },
  "verdicts": {
    "answer_events": [
      "PreToolUse",
      "Stop",
      "UserPromptSubmit"
    ],
    "bare_allow": "silent",
    "context_events": [
      "SessionStart",
      "UserPromptSubmit"
    ],
    "context_source": "context",
    "degrade_notes": {
      "escalate": "Droid's ask does not force a prompt, so this is a block",
      "escalate_from_transform": "Droid merges updatedInput into the original input rather than replacing it, so this is a block",
      "transform": "Droid merges updatedInput into the original input rather than replacing it, so this is a block"
    },
    "echo": "reverse_map",
    "gates": {
      "PreToolUse": {
        "grammar": "G2",
        "honours_escalate": false,
        "honours_transform": false
      },
      "Stop": {
        "grammar": "G1",
        "honours_escalate": false,
        "honours_transform": false
      },
      "UserPromptSubmit": {
        "grammar": "G1",
        "honours_escalate": false,
        "honours_transform": false
      }
    },
    "note_style": "suffix",
    "reason_defaults": {
      "deny_gate": "blocked"
    },
    "vocabulary": [
      "allow",
      "ask",
      "block",
      "deny"
    ],
    "vocabulary_basis": "verified",
    "words": {
      "block": "block",
      "deny": "deny"
    }
  }
}
