{
  "agent": "antigravity",
  "claims": {
    "mode": "shape_inferred"
  },
  "config_format": "json",
  "config_path": ".agents/hooks.json",
  "display": "Antigravity",
  "events": {},
  "evidence": {
    "claims": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_examples.py::test_each_payload_is_claimed_by_its_own_adapter"
    },
    "config_path": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_vendor_config.py::test_config_path_agrees_with_matrix"
    },
    "events": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_examples.py::test_each_payload_parses_to_the_event_it_is_filed_under"
    },
    "family": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_golden_fixtures.py::test_wire_output_matches_the_frozen_fixture"
    },
    "fields": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_vendor_config.py::test_entries_match_recount"
    },
    "hook_entry": {
      "basis": "vendor-docs",
      "date": "2026-10-17",
      "test": "tests/test_adapter_antigravity.py::test_hook_config_lists_stop_handlers_bare_as_documented"
    },
    "loads_claude_plugins": {
      "basis": "vendor-docs",
      "date": "2026-10-17",
      "test": "tests/test_claude_plugins.py::test_each_entry_records_the_discovery_row"
    },
    "tools": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_vendor_config.py::test_entries_match_recount"
    },
    "verdicts": {
      "basis": "vendor-docs",
      "date": "2026-08-26",
      "test": "tests/test_golden_fixtures.py::test_wire_output_matches_the_frozen_fixture"
    }
  },
  "family": "antigravity",
  "fields": {
    "command": [
      "toolCall.args.CommandLine"
    ],
    "content": [
      "toolCall.args.CodeContent",
      "toolCall.args.ReplacementContent",
      "toolCall.args.ReplacementChunks[].ReplacementContent"
    ],
    "cwd": [
      "toolCall.args.Cwd",
      "workspacePaths[0]"
    ],
    "output": [
      "error"
    ],
    "path": [
      "toolCall.args.TargetFile",
      "toolCall.args.AbsolutePath"
    ],
    "session_id": [
      "conversationId"
    ],
    "stringify": [
      "tool_use_id"
    ],
    "tool": [
      "toolCall.name"
    ],
    "tool_use_id": [
      "stepIdx"
    ]
  },
  "hook_entry": {
    "default_match": "*",
    "flat_events": [
      "Stop"
    ],
    "group": "agentseam",
    "matcher": true,
    "wrapper": "hooks_map"
  },
  "loads_claude_plugins": {
    "deny_reply": "no",
    "hooks": "n/a",
    "how": "n/a; needs a root plugin.json in its own schema (additionalProperties: false)",
    "loads": "no",
    "notes": "own hooks reply with a top-level decision",
    "payload": "own (camelCase toolCall)",
    "source": "https://antigravity.google/docs/plugins (org-plan discovery/2026-10-17-claude-plugin-compat.md)"
  },
  "needs_trust": false,
  "tools": {},
  "verdicts": {
    "answer_events": [
      "PreToolUse",
      "Stop"
    ],
    "bare_allow": "unverified",
    "default_wire_event": "PreToolUse",
    "degrade_notes": {
      "escalate": "Antigravity cannot prompt at Stop",
      "escalate_from_transform": "Antigravity can modify tool arguments only at PreToolUse",
      "transform": "Antigravity can modify tool arguments only at PreToolUse",
      "transform_missing_input": "no replacement arguments were supplied"
    },
    "empty_object_events": [
      "PostToolUse"
    ],
    "gate_reason_defaults": {
      "Stop": "policy requires more work"
    },
    "gates": {
      "PreToolUse": {
        "grammar": "G1",
        "honours_escalate": true,
        "honours_transform": true
      },
      "Stop": {
        "grammar": "G1",
        "honours_escalate": false,
        "honours_transform": false
      }
    },
    "note_style": "because",
    "reason_defaults": {
      "escalate": "confirmation required"
    },
    "transform_grammar": "top_level_overwrite",
    "vocabulary": [
      "allow",
      "ask",
      "auto_approve",
      "continue",
      "deny",
      "deny_unless_prior_grant",
      "force_ask",
      "stop"
    ],
    "vocabulary_basis": "verified",
    "words": {
      "allow": "allow",
      "block": "deny",
      "escalate": "ask",
      "transform": "allow"
    },
    "words_at": {
      "Stop": {
        "allow": "stop",
        "block": "continue"
      }
    }
  },
  "wire_events": {
    "post_tool": "PostToolUse",
    "pre_tool": "PreToolUse",
    "stop": "Stop"
  }
}
