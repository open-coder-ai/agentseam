{
  "agent": "mistral_vibe",
  "claims": {
    "event_key": [
      "hook_event_name"
    ],
    "mode": "marker",
    "notes": "Vibe names the event under hook_event_name with its own snake_case hook types (pre_tool, post_tool, post_agent), which no other adapter maps, so the event name alone separates it (docs.mistral.ai/vibe/code/cli/hooks and vibe/core/hooks/models.py HookType at mistral-vibe 2.26.1, read 2026-10-11)."
  },
  "config_format": "toml",
  "config_path": ".vibe/hooks.toml",
  "display": "Mistral Vibe",
  "events": {
    "post_agent": "stop",
    "post_tool": "post_tool",
    "pre_tool": "pre_tool"
  },
  "evidence": {
    "claims": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_examples.py::test_each_payload_is_claimed_by_its_own_adapter"
    },
    "config_path": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_vendor_config.py::test_config_path_agrees_with_matrix"
    },
    "events": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_examples.py::test_each_payload_parses_to_the_event_it_is_filed_under"
    },
    "family": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_golden_fixtures.py::test_wire_output_matches_the_frozen_fixture"
    },
    "fields": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_vendor_config.py::test_entries_match_recount"
    },
    "hook_entry": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_golden_fixtures.py::test_hook_config_matches_the_frozen_fixture_on_both_matcher_paths"
    },
    "tools": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_vendor_config.py::test_entries_match_recount"
    },
    "verdicts": {
      "basis": "vendor-docs",
      "date": "2026-10-11",
      "test": "tests/test_golden_fixtures.py::test_wire_output_matches_the_frozen_fixture"
    }
  },
  "family": "flat_decision",
  "fields": {
    "command": [
      "tool_input.command"
    ],
    "content": [
      "tool_input.content",
      "tool_input.new_string"
    ],
    "cwd": [
      "cwd"
    ],
    "output": [
      "tool_output_text"
    ],
    "path": [
      "tool_input.file_path",
      "tool_input.path"
    ],
    "session_id": [
      "session_id"
    ],
    "tool": [
      "tool_name"
    ],
    "tool_use_id": [
      "tool_call_id"
    ]
  },
  "hook_entry": {
    "default_match": "*",
    "matcher": true,
    "rule_keys": {
      "event": "type",
      "matcher": "match"
    },
    "rule_name_prefix": "agentseam-",
    "wrapper": "flat_list"
  },
  "needs_trust": true,
  "tools": {
    "shell": [
      "bash",
      "powershell",
      "git_bash"
    ],
    "write": [
      "write_file",
      "edit"
    ]
  },
  "verdicts": {
    "answer_events": [
      "post_agent",
      "pre_tool"
    ],
    "bare_allow": "silent",
    "degrade_notes": {
      "escalate": "Vibe cannot prompt for confirmation from a hook",
      "escalate_from_transform": "agentseam does not write Vibe's tool_input rewrite",
      "transform": "agentseam does not write Vibe's tool_input rewrite"
    },
    "echo": "payload",
    "gates": {
      "post_agent": {
        "grammar": "G1",
        "honours_escalate": false,
        "honours_transform": false
      },
      "pre_tool": {
        "grammar": "G1",
        "honours_escalate": false,
        "honours_transform": false
      }
    },
    "note_style": "because",
    "vocabulary": [
      "allow",
      "deny"
    ],
    "vocabulary_basis": "verified",
    "words": {
      "block": "deny"
    }
  }
}
