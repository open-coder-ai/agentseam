{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-coder-ai/agentseam/blob/main/src/agentseam/data/packaging-limits.schema.json",
  "title": "agentseam packaging limits",
  "description": [
    "The per-vendor packaging gaps beside data/packaging.json: part_limits records why a",
    "recorded format still has nowhere to put one part kind, also_reads the foreign layout",
    "directories a vendor reads besides its own, unrecorded why an agent has no packaging",
    "row at all. Part keys are the closed packaging_data.PARTS vocabulary so a typo'd part",
    "name fails loud, not fail open."
  ],
  "type": "object",
  "additionalProperties": false,
  "required": ["part_limits", "also_reads", "unrecorded"],
  "properties": {
    "part_limits": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/perPartText"}
    },
    "also_reads": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/perPartPaths"}
    },
    "unrecorded": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "perPartText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill": {"type": "string", "minLength": 1},
        "subagent": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "hooks": {"type": "string", "minLength": 1},
        "mcp": {"type": "string", "minLength": 1},
        "executable": {"type": "string", "minLength": 1}
      }
    },
    "perPartPaths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skill": {"$ref": "#/$defs/pathList"},
        "subagent": {"$ref": "#/$defs/pathList"},
        "command": {"$ref": "#/$defs/pathList"},
        "hooks": {"$ref": "#/$defs/pathList"},
        "mcp": {"$ref": "#/$defs/pathList"},
        "executable": {"$ref": "#/$defs/pathList"}
      }
    },
    "pathList": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
