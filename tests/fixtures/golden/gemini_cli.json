          "exit": 0,
          "stdout": ""
        },
        "vouch": {
          "exit": 0,
          "stdout": ""
        }
      },
      "payload": {
        "cwd": "/repo",
        "hook_event_name": "PreCompress",
        "session_id": "example",
        "trigger": "auto"
      }
    },
    "pre_tool": {
      "outcomes": {
        "allow": {
          "exit": 0,
          "stdout": "{\"decision\": \"allow\"}"
        },
        "ask": {
          "exit": 0,
          "stdout": "{\"decision\": \"ask\", \"reason\": \"confirm\"}"
        },
        "deny": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"policy\"}"
        },
        "rewrite": {
          "exit": 0,
          "stdout": "{\"hookSpecificOutput\": {\"tool_input\": {\"content\": \"safe\"}}}"
        },
        "rewrite-without-input": {
          "exit": 0,
          "stdout": "{\"hookSpecificOutput\": {\"tool_input\": null}}"
        },
        "vouch": {
          "exit": 0,
          "stdout": "{\"decision\": \"allow\"}"
        }
      },
      "payload": {
        "cwd": "/repo",
        "hook_event_name": "BeforeTool",
        "session_id": "example",
        "tool_input": {
          "content": "AWS_SECRET_ACCESS_KEY=EXAMPLE-PLACEHOLDER-NOT-A-KEY",
          "file_path": "AGENTS.md"
        },
        "tool_name": "write_file"
      }
    },
    "prompt_submit": {
      "outcomes": {
        "allow": {
          "exit": 0,
          "stdout": "{\"decision\": \"allow\"}"
        },
        "ask": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"confirm (confirmation required; BeforeAgent cannot prompt from a hook)\"}"
        },
        "deny": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"policy\"}"
