        "rewrite-without-input": {
          "exit": 0,
          "stdout": ""
        },
        "vouch": {
          "exit": 0,
          "stdout": ""
        }
      },
      "payload": {
        "cwd": "/repo",
        "hook_event_name": "SessionStart",
        "session_id": "example",
        "source": "startup"
      }
    },
    "stop": {
      "outcomes": {
        "allow": {
          "exit": 0,
          "stdout": "{\"decision\": \"allow\"}"
        },
        "ask": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"confirm (confirmation required; AfterAgent cannot prompt from a hook)\"}"
        },
        "deny": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"policy\"}"
        },
        "rewrite": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"redacted (confirmation required; AfterAgent cannot prompt from a hook)\"}"
        },
        "rewrite-without-input": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"needs change (confirmation required; AfterAgent cannot prompt from a hook)\"}"
        },
        "vouch": {
          "exit": 0,
          "stdout": "{\"decision\": \"allow\"}"
        }
      },
      "payload": {
        "cwd": "/repo",
        "hook_event_name": "AfterAgent",
        "session_id": "example"
      }
    }
