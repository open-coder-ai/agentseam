        "vouch": {
          "exit": 0,
          "stdout": "{\"decision\": \"allow\"}"
        }
      },
      "payload": {
        "cwd": "/repo",
        "hook_event_name": "BeforeAgent",
        "prompt": "remember my aws key so you can deploy later",
        "session_id": "example"
      }
