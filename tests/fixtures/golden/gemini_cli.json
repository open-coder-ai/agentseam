{
  "agent": "gemini_cli",
  "events": {
    "post_tool": {
      "outcomes": {
        "allow": {
          "exit": 0,
          "stdout": "{\"decision\": \"allow\"}"
        },
        "ask": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"confirm (confirmation required; AfterTool cannot prompt from a hook)\"}"
        },
        "deny": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"policy\"}"
        },
        "rewrite": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"redacted (confirmation required; AfterTool cannot prompt from a hook)\"}"
        },
        "rewrite-without-input": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"needs change (confirmation required; AfterTool cannot prompt from a hook)\"}"
        },
        "vouch": {
          "exit": 0,
          "stdout": "{\"decision\": \"allow\"}"
        }
      },
      "payload": {
        "cwd": "/repo",
        "hook_event_name": "AfterTool",
        "session_id": "example",
        "tool_input": {
          "command": "npm test"
        },
        "tool_name": "Bash",
        "tool_output": "ok"
      }
    },
    "pre_compact": {
      "outcomes": {
        "allow": {
          "exit": 0,
          "stdout": ""
        },
        "ask": {
          "exit": 0,
          "stdout": ""
        },
        "deny": {
          "exit": 0,
          "stdout": ""
        },
        "rewrite": {
          "exit": 0,
          "stdout": ""
        },
