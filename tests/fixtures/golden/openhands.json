{
  "agent": "openhands",
  "events": {
    "post_tool": {
      "outcomes": {
        "allow": {
          "exit": 0,
          "stdout": ""
        },
        "ask": {
          "exit": 0,
          "stdout": ""
        },
        "deny": {
          "exit": 0,
          "stdout": ""
        },
        "rewrite": {
          "exit": 0,
          "stdout": ""
        },
        "rewrite-without-input": {
          "exit": 0,
          "stdout": ""
        },
        "vouch": {
          "exit": 0,
          "stdout": ""
        }
      },
      "payload": {
        "event_type": "PostToolUse",
        "session_id": "example",
        "tool_input": {
          "command": "npm test"
        },
        "tool_name": "terminal",
        "tool_response": {
          "exit_code": 1
        },
        "working_dir": "/repo"
      }
    },
    "pre_tool": {
      "outcomes": {
        "allow": {
          "exit": 0,
          "stdout": ""
        },
        "ask": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"confirm (OpenHands cannot prompt for confirmation)\"}"
        },
        "deny": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"policy\"}"
        },
        "rewrite": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"redacted (OpenHands cannot modify a tool call)\"}"
        },
        "rewrite-without-input": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"needs change (OpenHands cannot modify a tool call)\"}"
        },
        "vouch": {
          "exit": 0,
          "stdout": ""
        }
      },
      "payload": {
        "event_type": "PreToolUse",
        "session_id": "example",
        "tool_input": {
          "command": "create",
          "file_text": "AWS_SECRET_ACCESS_KEY=EXAMPLE-PLACEHOLDER-NOT-A-KEY",
          "path": "AGENTS.md"
        },
        "tool_name": "file_editor",
        "working_dir": "/repo"
      }
    },
    "prompt_submit": {
      "outcomes": {
        "allow": {
          "exit": 0,
          "stdout": ""
        },
        "ask": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"confirm (OpenHands cannot prompt for confirmation)\"}"
        },
        "deny": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"policy\"}"
        },
        "rewrite": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"redacted (OpenHands cannot modify a tool call)\"}"
        },
        "rewrite-without-input": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"needs change (OpenHands cannot modify a tool call)\"}"
        },
        "vouch": {
          "exit": 0,
          "stdout": ""
        }
      },
      "payload": {
        "event_type": "UserPromptSubmit",
        "message": "remember my aws key so you can deploy later",
        "session_id": "example",
        "working_dir": "/repo"
      }
    },
    "session_end": {
      "outcomes": {
        "allow": {
          "exit": 0,
          "stdout": ""
        },
        "ask": {
          "exit": 0,
          "stdout": ""
        },
        "deny": {
          "exit": 0,
          "stdout": ""
        },
        "rewrite": {
          "exit": 0,
          "stdout": ""
        },
        "rewrite-without-input": {
          "exit": 0,
          "stdout": ""
        },
        "vouch": {
          "exit": 0,
          "stdout": ""
        }
      },
      "payload": {
        "event_type": "SessionEnd",
        "session_id": "example",
        "working_dir": "/repo"
      }
    },
    "session_start": {
      "outcomes": {
        "allow": {
          "exit": 0,
          "stdout": ""
        },
        "ask": {
          "exit": 0,
          "stdout": ""
        },
        "deny": {
          "exit": 0,
          "stdout": ""
        },
        "rewrite": {
          "exit": 0,
          "stdout": ""
        },
        "rewrite-without-input": {
          "exit": 0,
          "stdout": ""
        },
        "vouch": {
          "exit": 0,
          "stdout": ""
        }
      },
      "payload": {
        "event_type": "SessionStart",
        "session_id": "example",
        "working_dir": "/repo"
      }
    },
    "stop": {
      "outcomes": {
        "allow": {
          "exit": 0,
          "stdout": ""
        },
        "ask": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"confirm (OpenHands cannot prompt for confirmation)\"}"
        },
        "deny": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"policy\"}"
        },
        "rewrite": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"redacted (OpenHands cannot modify a tool call)\"}"
        },
        "rewrite-without-input": {
          "exit": 0,
          "stdout": "{\"decision\": \"deny\", \"reason\": \"needs change (OpenHands cannot modify a tool call)\"}"
        },
        "vouch": {
          "exit": 0,
          "stdout": ""
        }
      },
      "payload": {
        "event_type": "Stop",
        "session_id": "example",
        "working_dir": "/repo"
      }
    }
  },
  "hook_config": {
    "command": "python3 guard.py",
    "events": [
      "post_tool",
      "pre_tool",
      "prompt_submit",
      "session_end",
      "session_start",
      "stop"
    ],
    "no_matcher": {
      "hooks": {
        "PostToolUse": [
          {
            "hooks": [
              {
                "command": "python3 guard.py",
                "type": "command"
              }
            ]
          }
        ],
        "PreToolUse": [
          {
            "hooks": [
              {
                "command": "python3 guard.py",
                "type": "command"
              }
            ]
          }
        ],
        "SessionEnd": [
          {
            "hooks": [
              {
                "command": "python3 guard.py",
                "type": "command"
              }
            ]
          }
        ],
        "SessionStart": [
          {
            "hooks": [
              {
                "command": "python3 guard.py",
                "type": "command"
              }
            ]
          }
        ],
        "Stop": [
          {
            "hooks": [
              {
                "command": "python3 guard.py",
                "type": "command"
              }
            ]
          }
        ],
