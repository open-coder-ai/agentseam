            {
              "hooks": [
                {
                  "command": "python3 guard.py",
                  "type": "command"
                }
              ],
              "matcher": "Bash"
            }
          ],
          "PreToolUse": [
            {
              "hooks": [
                {
                  "command": "python3 guard.py",
                  "type": "command"
                }
              ],
              "matcher": "Bash"
            }
          ],
          "SessionEnd": [
            {
              "hooks": [
                {
                  "command": "python3 guard.py",
                  "type": "command"
                }
              ]
            }
          ],
          "SessionStart": [
            {
              "hooks": [
                {
                  "command": "python3 guard.py",
                  "type": "command"
                }
              ]
            }
          ],
          "Stop": [
            {
              "hooks": [
                {
                  "command": "python3 guard.py",
                  "type": "command"
                }
              ]
            }
          ],
          "UserPromptSubmit": [
            {
              "hooks": [
                {
                  "command": "python3 guard.py",
                  "type": "command"
                }
              ]
            }
          ]
        }
