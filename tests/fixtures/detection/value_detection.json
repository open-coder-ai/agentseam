{
  "_about": "Value-based detection (org-plan plan/one-oh-gaps.md D1). `vendor_doc_payloads` are copied from the cited vendor docs; `golden_detection` pins what detect() returned for every golden wire fixture before D1, which D1 must not change; factory_droid and mistral_vibe (D2a) and cline (D2b) are pinned from their first capture. Home-directory paths in the vendors' examples are replaced with /repo, because tests/test_no_private_data.py forbids home paths in tracked files; no path value takes part in detection.",
  "vendor_doc_payloads": [
    {
      "name": "factory_droid_pre_tool_use_create",
      "vendor": "factory_droid",
      "expect": "factory_droid",
      "why": "permission_mode 'off' is a value Claude Code never sends and factory_droid accepts (D2a; before it, D1 left this undetected).",
      "source": {
        "url": "https://docs.factory.com/harness/hooks",
        "section": "Hook input (tool hooks example)",
        "version": "droid 0.238.0 (npm latest, published 2026-10-10)",
        "read": "2026-10-11"
      },
      "payload": {
        "session_id": "abc123",
        "transcript_path": "/repo/.factory/projects/repo/session.jsonl",
        "cwd": "/repo",
        "permission_mode": "off",
        "hook_event_name": "PreToolUse",
        "tool_name": "Create",
        "tool_input": {
          "file_path": "/repo/file.txt",
          "content": "file content"
        }
      },
      "expect_event": "pre_tool"
    },
    {
      "name": "kiro_agent_spawn",
      "vendor": "kiro",
      "expect": null,
      "why": "Kiro has no adapter (D2); agentSpawn is no event Claude Code sends.",
      "source": {
        "url": "https://kiro.dev/docs/hooks/types/",
        "version": "Kiro CLI 2.29.0 (changelog, 2026-10-09); page updated 2026-10-10",
        "read": "2026-10-11",
        "section": "Agent Spawn (CLI 2.x and V3 alias)"
      },
      "payload": {
        "hook_event_name": "agentSpawn",
        "cwd": "/current/working/directory",
        "session_id": "abc123-def456-789"
      }
    },
    {
      "name": "kiro_pre_tool_use_mcp",
      "vendor": "kiro",
      "expect": null,
      "why": "Kiro has no adapter (D2); mcp_<server>_<tool> is not Claude Code's mcp__<server>__<tool> spelling.",
      "source": {
        "url": "https://kiro.dev/docs/hooks/types/",
        "version": "Kiro CLI 2.29.0 (changelog, 2026-10-09); page updated 2026-10-10",
        "read": "2026-10-11",
        "section": "MCP tool hooks"
      },
      "payload": {
        "hook_event_name": "PreToolUse",
        "cwd": "/current/working/directory",
        "session_id": "abc123-def456-789",
        "tool_name": "mcp_postgres_query",
        "tool_input": {
          "sql": "SELECT * FROM orders LIMIT 10;"
        }
      }
    },
    {
      "name": "grok_build_pre_tool_use",
      "vendor": "grok",
      "expect": "grok",
      "expect_event": "pre_tool",
      "why": "hookEventName is hook_event_name's snake_case twin, the Grok Build envelope (agentseam#185 measured vscode_copilot here).",
      "source": {
        "url": "https://github.com/xai-org/grok-build/blob/2bdd1d6a6369de0e8c68132ea4539e9abd9e14a8/crates/codegen/xai-grok-pager/docs/user-guide/10-hooks.md",
        "section": "Writing Hook Scripts > Input",
        "version": "Grok Build v1.0.50 (x.ai/changelog/build, 2026-10-06); guide at main 2bdd1d6",
        "read": "2026-10-11"
      },
      "payload": {
        "hookEventName": "pre_tool_use",
        "hook_event_name": "PreToolUse",
        "sessionId": "abc-123",
        "cwd": "/repo",
        "workspaceRoot": "/repo",
        "permissionMode": "default",
        "toolName": "run_terminal_command",
        "toolInput": {
          "command": "npm test"
        },
        "timestamp": "2026-04-14T12:00:00Z"
      }
    },
    {
      "name": "cline_pre_tool_use_vscode",
      "vendor": "cline",
      "expect": "cline",
      "why": "clineVersion is a key no other vendor sends; the extension names the event after the hook file (PreToolUse). Before D2b no adapter claimed it.",
      "source": {
        "url": "https://github.com/cline/cline/blob/main/.clinerules/hooks/README.md",
        "section": "Hook Input/Output: Input (via stdin as JSON), with the README's own write_to_file example",
        "version": "Cline VS Code extension 4.1.23 and CLI 3.0.70, cline/cline main c3a40572 (2026-10-10)",
        "read": "2026-10-11"
      },
      "payload": {
        "clineVersion": "4.1.23",
        "hookName": "PreToolUse",
        "timestamp": "2026-10-11T00:00:00.000Z",
        "taskId": "1760140800000",
        "workspaceRoots": [
          "/repo"
        ],
        "userId": "user",
        "preToolUse": {
          "toolName": "write_to_file",
          "parameters": {
            "path": "src/index.js",
            "content": "console.log(1)"
          }
        }
      },
      "expect_event": "pre_tool"
    },
    {
      "name": "cline_tool_call_cli",
      "vendor": "cline",
      "expect": "cline",
      "why": "The CLI/SDK sends its own event name (tool_call) for the PreToolUse file, plus the raw tool_call; clineVersion is present, empty when CLINE_VERSION is unset.",
      "source": {
        "url": "https://github.com/cline/cline/blob/main/sdk/packages/core/src/hooks/hook-file-hooks.ts",
        "section": "createPayloadBase and runToolCallStart (the payload a PreToolUse file receives from the CLI)",
        "version": "Cline VS Code extension 4.1.23 and CLI 3.0.70, cline/cline main c3a40572 (2026-10-10)",
        "read": "2026-10-11"
      },
      "payload": {
        "clineVersion": "",
        "timestamp": "2026-10-11T00:00:00.000Z",
        "taskId": "conv-1",
        "sessionContext": {
          "rootSessionId": "conv-1"
        },
        "workspaceRoots": [
          "/repo"
        ],
        "userId": "user",
        "agent_id": "agent-1",
        "parent_agent_id": null,
        "hookName": "tool_call",
        "iteration": 1,
        "tool_call": {
          "id": "call-1",
          "name": "run_commands",
          "input": {
            "commands": [
              "npm test"
            ]
          }
        },
        "preToolUse": {
          "toolName": "run_commands",
          "parameters": {
            "commands": "[\"npm test\"]"
          }
        }
      },
      "expect_event": "pre_tool"
    }
  ],
