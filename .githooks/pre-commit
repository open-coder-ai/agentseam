#!/bin/sh
# Refresh the generated vendor examples when a commit touches what they are generated from.
#
# The pages under examples/generated/ are produced from the real code paths, so a change to
# an adapter or to the matrix silently invalidates them. CI catches that, but finding out
# from a red pipeline is a wasted round trip -- this puts the regenerated files in the same
# commit as the change that caused them.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Not a substitute for the CI check: hooks are not cloned, and --no-verify skips them. This
# is the convenience; `examples/generate.py --check` in CI is the guarantee.
set -e

# Only the sources the pages are generated from. Editing a test or a README changes nothing
# about the output, and regenerating on every commit would be noise.
if ! git diff --cached --name-only | grep -qE '^(src/agentseam/|examples/(generate|scenarios|vendor_payloads)\.py$)'; then
    exit 0
fi

# The first candidate that actually RUNS a Python 3.9+. `command -v` alone is not enough: on
# Windows it finds the Microsoft Store's python3 stub, which exits non-zero, and under set -e
# that blocked every commit touching src/.
py=
for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1 &&
        "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
        py=$candidate
        break
    fi
done
if [ -z "$py" ]; then
    echo "pre-commit: no working python3/python/py found, skipping example refresh" >&2
    echo "pre-commit: run 'python3 examples/generate.py' before pushing, or CI will fail" >&2
    exit 0
fi

before=$(git diff --cached --name-only -- examples/generated)
"$py" examples/generate.py >/dev/null
git add examples/generated

# Report only when the commit actually gained something, so a no-op stays silent.
after=$(git diff --cached --name-only -- examples/generated)
if [ "$before" != "$after" ]; then
    echo "pre-commit: refreshed examples/generated and added it to this commit"
fi
